{minimum_otp_vsn, "29"}.
{erl_opts, [debug_info]}.
{deps, [
    {uuid, {git, "https://github.com/okeuday/uuid.git", {tag, "v2.0.7.1"}}},
    {pgo,
        % Contains upstream dialyzer fixes
        % can use erleans/pgo when these are merged,
        % - https://github.com/erleans/pgo/pull/129
        % - https://github.com/erleans/pgo/pull/135
        {git, "https://github.com/chiroptical/pgo",
            {ref, "ad293eadf9c34cc68b9c8b2b9c8c45919798f947"}}}
]}.
{profiles, [
    {analysis, [
        {dialyzer, [
            {plt_extra_apps, [uuid, ssl, public_key, pgo, pg_types, syntax_tools, rebar, providers]}
        ]},
        {deps, [
            {rebar,
                {git_subdir, "https://github.com/erlang/rebar3.git",
                    {ref, "619df55d9dab109cbd1b5d9ed1d45c93f5450e24"}, "apps/rebar"}}
        ]},
        {overrides, [
            {override, rebar, [
                {erl_opts, [debug_info, nowarn_deprecated_catch]},
                {profiles, []}
            ]},
            {add, erlware_commons, [{erl_opts, [nowarn_deprecated_catch, nowarn_match_alias_pats]}]},
            {add, relx, [{erl_opts, [nowarn_deprecated_catch]}]}
        ]}
    ]},
    {examples, [
        {src_dirs, ["src", "scripts"]},
        {extra_src_dirs, ["examples"]},
        {escript_name, generate_examples},
        {escript_emu_args, "%%! -escript main generate_examples\n"}
    ]}
]}.
{dialyzer, [
    {plt_extra_apps, [uuid, ssl, public_key, pgo, pg_types, syntax_tools]},
    {warnings, [missing_return]}
]}.
